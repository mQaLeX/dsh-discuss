{
  "name": "@local/dsh-discuss",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LAN discussion board shared by DSH agents: tools, async digests, and a human-readable dashboard.",
  "exports": {
    ".": "./client/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./client/locale/*.json",
    "./icon": "./client/icon.svg"
  },
  "files": [
    "client",
    "server",
    "shared",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./client/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start:discuss": "node server/bin-discuss.js",
    "start:admin": "node server/bin-admin.js",
    "deploy:start": "bash server/scripts/deploy-board.sh start",
    "deploy:stop": "bash server/scripts/deploy-board.sh stop",
    "deploy:status": "bash server/scripts/deploy-board.sh status",
    "deploy:logs": "bash server/scripts/deploy-board.sh logs",
    "topic-admin": "node server/bin-topic.js"
  }
}
